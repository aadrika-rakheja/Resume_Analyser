# Server Configuration
PORT=5000

# Database Configuration (Optional)
# If left blank, the server will seamlessly create and utilize a local JSON store 'local_db.json'
MONGODB_URI=mongodb://localhost:27017/ai_resume_analyzer

# JWT Security
JWT_SECRET=your_super_secure_jwt_token_secret_key_here

# AI Service Configuration (Optional)
# Provide keys to activate premium real-time AI parsing. If omitted, the server uses a refined offline NLP rule-engine out-of-the-box!
GEMINI_API_KEY=
OPENAI_API_KEY=
